{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 16,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "mingw32-cross",
      "displayName": "gamex86.dll (MinGW i686 cross)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-mingw32.cmake",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "mingw32-cross-release",
      "displayName": "gamex86.dll (MinGW i686, Release)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/cmake/toolchain-mingw32.cmake",
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "mingw32-cross",
      "configurePreset": "mingw32-cross"
    },
    {
      "name": "mingw32-cross-release",
      "configurePreset": "mingw32-cross-release"
    }
  ]
}
